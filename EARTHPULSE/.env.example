# ============================================================
# EARTHPULSE — Environment Configuration Example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Hugging Face ---
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL_ID=

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- Database (future) ---
DATABASE_URL=

# --- Logging ---
LOG_LEVEL=INFO
